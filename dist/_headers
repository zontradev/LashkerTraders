# ==============================================================================
# Lashker Traders — Cloudflare Edge Security & Cache Policy Headers
# Domain: lashkertraders.com
# ==============================================================================

# Global Edge Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache-Control: Immutable Hashed Assets (1 Year Browser & Cloudflare Edge Cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-Control: Web Fonts, Favicon & Vectors
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/manifest.json
  Cache-Control: public, max-age=86400

# Private & Uncached Routes (Never cache checkout, customer account, admin, or orders in shared edge caches)
/checkout
  Cache-Control: no-cache, no-store, must-revalidate, private

/account
  Cache-Control: no-cache, no-store, must-revalidate, private

/track-order
  Cache-Control: no-cache, no-store, must-revalidate, private

/admin/*
  Cache-Control: no-cache, no-store, must-revalidate, private
